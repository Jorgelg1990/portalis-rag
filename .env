APP_NAME=portalis-rag
ENV=dev
SECRET_KEY=dev-secret
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTS=pdf,docx

# Providers - use mock by default (no real keys needed)
LLM_PROVIDER=mock
EMBED_PROVIDER=mock
EMBEDDING_DIM=384
EMBEDDING_MODEL=gemini/text-embedding-004
LITELLM_MODEL=gemini/gemini-1.5-flash
FALLBACK_LLM_PROVIDER=mock
FALLBACK_LITELLM_MODEL=gpt-4o-mini

# Ingestion
# docling = parser principal (layout + paginas + secciones). Si falla, cae a pypdf.
PARSER=docling
CHUNK_MAX_CHARS=800

# Evidence gating: similitud coseno minima para considerar un fragmento evidencia
MIN_EVIDENCE_SCORE=0.12

# Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=portalis-rag

# Workspace/Tenant (simple isolation)
DEFAULT_WORKSPACE_ID=default
