# Copy to .env and adjust if needed.
# Defaults below = fully working mock mode. NO real API keys required.

APP_NAME=portalis-rag
ENV=dev
SECRET_KEY=dev-secret
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTS=pdf,docx

# Providers: mock = deterministic, no credentials.
# Real mode: LLM_PROVIDER=litellm, EMBED_PROVIDER=litellm, GEMINI_API_KEY=...
LLM_PROVIDER=mock
EMBED_PROVIDER=mock
EMBEDDING_DIM=384
EMBEDDING_MODEL=gemini/text-embedding-004
LITELLM_MODEL=gemini/gemini-1.5-flash
FALLBACK_LLM_PROVIDER=mock
FALLBACK_LITELLM_MODEL=gpt-4o-mini

# Ingestion: docling (primary, falls back to pypdf/docx automatically)
PARSER=docling
CHUNK_MAX_CHARS=800

# Evidence gating: minimum cosine similarity to count a fragment as evidence
MIN_EVIDENCE_SCORE=0.12

# Optional: only needed for real providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Tracing (optional collector; app runs fine without it)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=portalis-rag

# Tenant/workspace isolation
DEFAULT_WORKSPACE_ID=default

# docker-compose overrides these with service names (db, redis):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/portalis
# SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/portalis
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
